# ======================================================================
# Smart Room Rental SaaS — Environment Variables
# Copy to .env and fill in your values
# ======================================================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:15432/rental_management
DB_USERNAME=rental_dev
DB_PASSWORD=rental_dev_pass

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=16379

# --- JWT ---
JWT_SECRET=change-me-super-secret-key-at-least-32-characters-long
JWT_ACCESS_TOKEN_MINUTES=60

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Admin Bootstrap ---
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_TENANT_NAME=System Administration
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE=0900000000
ADMIN_EMAIL=admin@roomrental.com
ADMIN_PASSWORD=Admin@1234

# --- Database Pool (optional) ---
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=10000

# --- Cloudinary (for image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret